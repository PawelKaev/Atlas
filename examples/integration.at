функция квадрат(n: Целое) -> Целое:
    вернуть n * n

функция факториал(n: Целое) -> Целое:
    если n <= 1:
        вернуть 1
    иначе:
        вернуть n * факториал(n - 1)

функция главная():
    написать("=== Atlas Integration Test ===")
    написать("")
    написать("1. Арифметика: 2 + 3 * 4 =")
    написать(2 + 3 * 4)
    написать("")
    написать("2. Квадрат 7:")
    написать(квадрат(7))
    написать("")
    написать("3. Факториал 5:")
    написать(факториал(5))
    написать("")
    написать("4. Обратный отсчёт:")
    n = 5
    пока n > 0:
        написать(n)
        n = n - 1
    написать("")
    написать("=== Test Complete ===")

главная()
